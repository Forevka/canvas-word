# syntax=docker/dockerfile:1.7
#
# @cw/web — builds the Vite frontend (multi-page: / offline editor + /live
# online collab demo) and serves it with Caddy, which also reverse-proxies the
# API/WebSocket paths to the backend so the whole app lives on one origin.

# 1. Build the static bundle. Vite resolves @cw/shared via its config alias to
#    ../shared/src, so shared must be present at build time.
FROM node:22-bookworm-slim AS build
WORKDIR /app
ENV PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1 \
    NPM_CONFIG_FUND=false \
    NPM_CONFIG_AUDIT=false
COPY package.json package-lock.json tsconfig.base.json ./
COPY shared/package.json ./shared/
COPY frontend/package.json ./frontend/
COPY backend/package.json ./backend/
RUN npm ci
COPY shared ./shared
COPY frontend ./frontend
RUN npm run build --workspace @cw/frontend

# 2. Serve + proxy with Caddy. Static files in /srv, API/WS to the backend.
FROM caddy:2-alpine
COPY web/Caddyfile /etc/caddy/Caddyfile
COPY --from=build /app/frontend/dist /srv
EXPOSE 80
