# Edge inside the compose network: one origin for the whole app.
#   - API + WebSocket paths  -> the backend collaboration server
#   - everything else        -> the built static frontend
# TLS is terminated by the *host* Caddy; this listens on plain :80.

:80 {
	encode zstd gzip

	# --- Cache policy --------------------------------------------------------
	# Vite fingerprints every JS/CSS/worker chunk under an assets/ dir, so the
	# filename changes on every rebuild. Cache those hard: a fresh deploy never
	# serves stale code (old hashed chunks/workers are simply never requested
	# again), and the large export/import worker bundle isn't re-fetched.
	@assets path /assets/* */assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"

	# Everything else that isn't the backend surface — HTML entry documents and
	# SPA fallbacks — must ALWAYS be revalidated, so a deployment's new asset
	# hashes are picked up on the next normal load (no hard-reload needed). This
	# is what evicts stale worker code after a deploy: a revalidated index.html
	# points at the new hashed chunks, which pull the new worker. The backend
	# sets its own cache headers, so its paths are left untouched.
	@revalidate {
		not path /assets/* */assets/*
		not path /docs /docs/* /media /media/* /ws /ws/* /admin /admin/* /upload /openapi.json /swagger /swagger/*
	}
	header @revalidate Cache-Control "no-cache"

	# Backend surface (see backend/src/server.ts): document/media CRUD, the
	# /ws collaboration socket, the admin API (+ webhooks), upload, and the
	# OpenAPI/Swagger docs. reverse_proxy auto-handles the /ws upgrade.
	@api path /docs /docs/* /media /media/* /ws /ws/* /admin /admin/* /upload /openapi.json /swagger /swagger/*
	handle @api {
		reverse_proxy backend:8787
	}

	# Admin dashboard SPA, built with base /dashboard/ and copied to /srv/dashboard.
	# Single bundle (no client-side routing), so fall back to its index.html.
	@dashboard path /dashboard /dashboard/*
	handle @dashboard {
		root * /srv
		try_files {path} /dashboard/index.html
		file_server
	}

	# Static files from /srv. The root index.html is the marketing landing page
	# (Dockerfile.web copies landing/index.html over the frontend app's index.html).
	#
	# This also serves the embedding examples placed under /srv by Dockerfile.web:
	#   /live              -> examples/embed-live  (online + collaboration)
	#   /examples/offline  -> examples/embed-offline
	#   /examples/ribbon   -> examples/ribbon-customization (customizeRibbon demo)
	#   /examples/constructor -> examples/editor-constructor (constructor config builder)
	#   /playground        -> examples/playground  (document-builder playground)
	#   /multi             -> examples/embed-multi  (multiple editors on one page)
	# These have RELATIVE asset URLs (./assets, ./wordcanvas), so they must load
	# under a trailing slash. file_server treats /srv/live as a directory and
	# canonically redirects /live -> /live/ (query preserved, so ?collab=… share
	# links keep working), then resolves its index.html — relative assets then
	# resolve under /live/.
	handle {
		root * /srv
		file_server
	}
}
