# Copy to .env (gitignored). Defaults match docker-compose.yml, so the stack
# runs without any .env at all — copy + edit only to change credentials/ports.
#
#   cp env.example .env
#
# Vars are CW_-prefixed to avoid colliding with another project's POSTGRES_* env.

# --- Postgres (shared by the postgres + flyway services) ---
CW_DB_USER=postgres
CW_DB_PASSWORD=postgres
CW_DB_NAME=canvasword
# Host port (container is always 5432). 5544 avoids cortex (5433) and a local PG.
CW_DB_PORT=5544

# --- Backend (Node server) ---
# Host-side connection string for `npm run dev` (the in-compose `backend`
# service overrides this to talk to the `postgres` service over the network).
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5544/canvasword
# Port the collaboration server (HTTP + WebSocket) listens on.
BACKEND_PORT=8787

# --- Full stack (`docker compose --profile app up`) ---
# Host port the `web` edge (static frontend + API/WS proxy) binds on 127.0.0.1.
# The host reverse proxy (Caddy) points doc-editor.<domain> at this port.
EDGE_PORT=3003
