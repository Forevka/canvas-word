# Copy to .env (gitignored). Defaults match docker-compose.yml, so the stack
# runs without any .env at all — copy + edit only to change credentials/ports.
#
#   cp env.example .env
#
# Vars are CW_-prefixed to avoid colliding with another project's POSTGRES_* env.

# --- Postgres (shared by the postgres + flyway services) ---
CW_DB_USER=postgres
CW_DB_PASSWORD=postgres
CW_DB_NAME=canvasword
# Host port (container is always 5432). 5544 avoids cortex (5433) and a local PG.
CW_DB_PORT=5544

# --- Backend (Node server) ---
# Host-side connection string for `npm run dev` (the in-compose `backend`
# service overrides this to talk to the `postgres` service over the network).
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5544/canvasword
# Port the collaboration server (HTTP + WebSocket) listens on.
BACKEND_PORT=8787

# --- Admin dashboard auth (CHANGE THESE in production) ---
# Single pre-seeded admin; bearer tokens are signed with ADMIN_TOKEN_SECRET.
# In production (NODE_ENV=production) the insecure dev defaults are REFUSED: the
# server throws on startup unless ADMIN_PASSWORD and ADMIN_TOKEN_SECRET are set.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin
ADMIN_TOKEN_SECRET=dev-insecure-token-secret-change-me
# Token lifetime (ms) and whether /upload requires a token (UPLOAD_PUBLIC=1 opens it).
ADMIN_TOKEN_TTL_MS=43200000
# UPLOAD_PUBLIC=0
# CORS allow-list for the API. Comma-separated origins, or "*" for any. Defaults
# to "*" in dev; in production it defaults to CLOSED — set this explicitly.
# CORS_ORIGIN=https://doc-editor.example.com

# --- Webhooks ---
# Public base URL used to build the docx/pdf download links in webhook payloads.
PUBLIC_BASE_URL=http://localhost:8787
# Debounce (ms) before a doc's "last editor disconnected" webhook fires; a rejoin
# inside this window cancels it. Bounded retry count per delivery.
SESSION_END_DEBOUNCE_MS=8000
WEBHOOK_MAX_ATTEMPTS=3

# --- Dashboard (Vite dev/build; @cw/dashboard) ---
# Where the dashboard's admin API and the editor live (defaults shown).
VITE_BACKEND_URL=http://localhost:8787
VITE_EDITOR_URL=http://localhost:5173

# --- Full stack (`docker compose --profile app up`) ---
# Host port the `web` edge (static frontend + API/WS proxy) binds on 127.0.0.1.
# The host reverse proxy (Caddy) points doc-editor.<domain> at this port.
EDGE_PORT=3003
