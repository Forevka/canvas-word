{
  "name": "@forevka/wordcanvas",
  "version": "0.7.1",
  "type": "module",
  "description": "Open-source embeddable Word-style document editor: canvas-rendered, with live collaboration, track changes & comments, and DOCX/PDF import & export. A lightweight alternative to Syncfusion, OnlyOffice, and DevExpress document editors. Self-contained, zero runtime dependencies.",
  "license": "MIT",
  "author": "Bohdan Lushchyk",
  "homepage": "https://github.com/Forevka/canvas-word#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Forevka/canvas-word.git",
    "directory": "frontend"
  },
  "bugs": {
    "url": "https://github.com/Forevka/canvas-word/issues"
  },
  "keywords": [
    "word",
    "editor",
    "word-editor",
    "word-processor",
    "document-editor",
    "docx",
    "docx-editor",
    "pdf",
    "canvas",
    "wysiwyg",
    "rich-text",
    "document",
    "collaboration",
    "track-changes",
    "comments",
    "suggestions",
    "embeddable",
    "syncfusion-alternative",
    "onlyoffice-alternative",
    "devexpress-alternative",
    "contenteditable-alternative"
  ],
  "module": "./dist-lib/wordcanvas.js",
  "types": "./types/wordcanvas.d.ts",
  "//exports": "Dual-target, all compiled — no raw src ships. `.`/`./builder` are the browser editor (Vite → dist-lib). The headless pipelines (import/export/measure/recalc-docx/generate-toc) are isomorphic and exposed via conditional exports: the `node` condition resolves a self-contained, Node-targeted bundle (scripts/build-node.mjs → dist-node, with disk fonts + bundled pdfkit) for server/headless use; the `default` condition resolves the browser variant (Vite → dist-lib). Hand-written types/ keeps the published .d.ts self-contained (no @cw/shared import). The in-repo backend consumes the `node` build through this map (no tsconfig path aliases).",
  "exports": {
    ".": {
      "types": "./types/wordcanvas.d.ts",
      "import": "./dist-lib/wordcanvas.js"
    },
    "./builder": {
      "types": "./types/builder.d.ts",
      "import": "./dist-lib/builder.js"
    },
    "./import": {
      "types": "./types/import.d.ts",
      "node": "./dist-node/import.js",
      "default": "./dist-lib/import.js"
    },
    "./export": {
      "types": "./types/export.d.ts",
      "node": "./dist-node/export.js",
      "default": "./dist-lib/export.js"
    },
    "./export/measure": {
      "types": "./types/measure.d.ts",
      "node": "./dist-node/measure.js",
      "default": "./dist-lib/measure.js"
    },
    "./recalc-docx": {
      "types": "./types/recalc-docx.d.ts",
      "node": "./dist-node/recalc-docx.js",
      "default": "./dist-lib/recalc-docx.js"
    },
    "./generate-toc": {
      "types": "./types/generate-toc.d.ts",
      "node": "./dist-node/generate-toc.js",
      "default": "./dist-lib/generate-toc.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist-lib",
    "dist-node",
    "types"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:lib": "vite build --mode lib",
    "build:node": "node scripts/build-node.mjs",
    "build:node:watch": "node scripts/build-node.mjs --watch",
    "build:dist": "npm run build:lib && npm run build:node",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "npm run typecheck && npm run build:dist"
  },
  "devDependencies": {
    "@chenglou/pretext": "latest",
    "@cw/shared": "*",
    "@mcp-b/global": "^3.0.0",
    "@types/fontkit": "^2.0.9",
    "@types/pdfkit": "^0.17.6",
    "esbuild": "^0.25.0",
    "fflate": "^0.8.3",
    "fontkit": "^2.0.4",
    "pdfkit": "^0.19.0",
    "playwright": "^1.60.0",
    "txml": "^6.0.0",
    "vite": "^6.0.0",
    "vite-plugin-node-polyfills": "^0.28.0",
    "vitest": "^3.0.0",
    "zod": "^3.25.76",
    "zod-to-json-schema": "^3.25.2"
  }
}
