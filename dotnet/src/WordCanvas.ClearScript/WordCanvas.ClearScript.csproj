<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>WordCanvas.ClearScript</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.ClearScript.V8" Version="7.5.1" />
    <PackageReference Include="Microsoft.ClearScript.V8.Native.win-x64" Version="7.5.1" />
  </ItemGroup>

  <!-- The headless JS bundle (esbuild output) copied next to the assembly. -->
  <ItemGroup>
    <None Include="assets\wordcanvas.clearscript.js" Condition="Exists('assets\wordcanvas.clearscript.js')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>assets\wordcanvas.clearscript.js</Link>
    </None>
  </ItemGroup>

  <!-- Bundled metric-clone + math fonts, linked from the frontend source of truth
       (not duplicated in git) and copied to output/fonts for host injection. -->
  <ItemGroup>
    <None Include="..\..\..\frontend\src\export\shared\fonts\*.ttf">
      <Link>fonts\%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
