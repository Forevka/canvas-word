{
  "name": "canvas-word-monorepo",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "workspaces": [
    "shared",
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @cw/frontend",
    "build": "npm run build --workspace @cw/frontend",
    "typecheck": "npm run typecheck --workspace @cw/shared && npm run typecheck --workspace @cw/frontend && npm run typecheck --workspace @cw/backend",
    "test": "npm run test --workspace @cw/frontend"
  },
  "devDependencies": {
    "typescript": "^5.6.0"
  }
}
