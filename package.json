{
  "name": "canvas-word-monorepo",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "workspaces": [
    "shared",
    "frontend",
    "backend",
    "dashboard",
    "examples/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @forevka/wordcanvas",
    "dev:dashboard": "npm run dev --workspace @cw/dashboard",
    "dev:example": "npm run dev --workspace @cw/example-embed-live",
    "dev:playground": "npm run dev --workspace @cw/example-playground",
    "dev:multi": "npm run dev --workspace @cw/example-embed-multi",
    "dev:constructor": "npm run dev --workspace @cw/example-editor-constructor",
    "build": "npm run build --workspace @forevka/wordcanvas",
    "build:lib": "npm run build:lib --workspace @forevka/wordcanvas",
    "typecheck": "npm run typecheck --workspace @cw/shared && npm run typecheck --workspace @forevka/wordcanvas && npm run typecheck --workspace @cw/backend && npm run typecheck --workspace @cw/dashboard",
    "test": "npm run test --workspace @cw/shared && npm run test --workspace @forevka/wordcanvas && npm run test --workspace @cw/backend",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "dev:online": "node scripts/dev-online.mjs"
  },
  "devDependencies": {
    "typescript": "^5.6.0"
  },
  "dependencies": {
    "@forevka/wordcanvas": "^0.2.0"
  }
}
