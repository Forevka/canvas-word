{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    // The server now hosts the browser-derived import/export pipelines (parse on
    // upload, .docx/.pdf export). Those pure modules are Node-safe at RUNTIME
    // (measurement contexts are injected before any DOM is touched), but their
    // TS source references ambient DOM types (document, fetch, Blob, ...). DOM
    // libs satisfy the typechecker; nothing here actually touches the DOM.
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "baseUrl": ".",
    "paths": {
      "@cw/shared": ["../shared/src/index.ts"],
      "@forevka/wordcanvas/import": ["../frontend/src/import/docx/pipeline.ts"],
      "@forevka/wordcanvas/export": ["../frontend/src/export/pipeline.ts"],
      "@forevka/wordcanvas/export/measure": ["../frontend/src/export/shared/measureHost.ts"],
      "@forevka/wordcanvas/recalc": ["../frontend/src/recalc/recalcToc.ts"]
    }
  },
  "include": ["src"]
}
