{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    // The server now hosts the browser-derived import/export pipelines (parse on
    // upload, .docx/.pdf export). Those pure modules are Node-safe at RUNTIME
    // (measurement contexts are injected before any DOM is touched), but their
    // TS source references ambient DOM types (document, fetch, Blob, ...). DOM
    // libs satisfy the typechecker; nothing here actually touches the DOM.
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "baseUrl": ".",
    "paths": {
      // @cw/shared is a private workspace package consumed straight from source.
      // The @forevka/wordcanvas pipelines, by contrast, resolve through the
      // package's own `exports` map (the `node` condition → dist-node for runtime,
      // the `types` condition → its hand-written .d.ts for typecheck) — the same
      // surface external consumers get. No path aliases for them on purpose; the
      // build is produced by `build:node` via the pre* scripts in package.json.
      "@cw/shared": ["../shared/src/index.ts"]
    }
  },
  "include": ["src"]
}
