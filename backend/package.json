{
  "name": "@cw/backend",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "//deps": "The backend reuses @forevka/wordcanvas's compiled Node pipelines (dist-node). The pre* hooks rebuild that bundle before any command so typecheck/test/run exercise the same output external consumers get. For a fast inner loop, run `npm run build:node:watch -w @forevka/wordcanvas` alongside `tsx watch`.",
    "predev": "npm run build:node --workspace @forevka/wordcanvas",
    "dev": "tsx watch src/server.ts",
    "prestart": "npm run build:node --workspace @forevka/wordcanvas",
    "start": "tsx src/server.ts",
    "pretypecheck": "npm run build:node --workspace @forevka/wordcanvas",
    "typecheck": "tsc --noEmit",
    "pretest": "npm run build:node --workspace @forevka/wordcanvas",
    "test": "vitest run"
  },
  "dependencies": {
    "@cw/shared": "*",
    "@fastify/cors": "^10.0.1",
    "@fastify/swagger": "^9.7.0",
    "@fastify/swagger-ui": "^5.2.6",
    "@fastify/websocket": "^11.0.1",
    "@forevka/wordcanvas": "*",
    "fastify": "^5.1.0",
    "pg": "^8.13.1",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/pg": "^8.11.10",
    "@types/ws": "^8.5.13",
    "tsx": "^4.19.2",
    "vitest": "^3.0.0"
  }
}
