# syntax=docker/dockerfile:1.7
#
# @cw/backend — the collaboration server (HTTP + WebSocket) run with tsx.
# Monorepo-aware: npm workspaces wire node_modules/@cw/shared -> ../shared, so
# we install once from the repo root, then copy only shared + backend sources.

# 1. Install workspace deps (cacheable: only package manifests change rarely).
FROM node:22-bookworm-slim AS deps
WORKDIR /app
ENV PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1 \
    NPM_CONFIG_FUND=false \
    NPM_CONFIG_AUDIT=false
COPY package.json package-lock.json tsconfig.base.json ./
COPY shared/package.json ./shared/
COPY frontend/package.json ./frontend/
COPY backend/package.json ./backend/
RUN npm ci

# 2. Runtime image: deps + the TS sources tsx executes directly.
FROM node:22-bookworm-slim AS runner
WORKDIR /app
ENV NODE_ENV=production \
    BACKEND_PORT=8787
COPY --from=deps /app/node_modules ./node_modules
COPY package.json tsconfig.base.json ./
COPY shared ./shared
COPY backend ./backend
USER node
EXPOSE 8787
# argv[1] ends with "server.ts" so the entry-point guard in server.ts fires.
CMD ["npx", "tsx", "backend/src/server.ts"]
